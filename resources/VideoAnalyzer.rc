#include <windows.h>
#include "../include/Resources.h"

IDD_STARTUP_PASSWORD DIALOGEX 0, 0, 280, 144
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Video Analyzer - Sign in"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Enter your password to open Video Analyzer.", -1, 16, 16, 248, 22
    LTEXT "Password", -1, 16, 44, 248, 12
    EDITTEXT IDC_STARTUP_PASSWORD, 16, 59, 248, 18, ES_PASSWORD | ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "", IDC_STARTUP_PASSWORD_ERROR, 16, 83, 248, 22
    PUSHBUTTON "Cancel", IDCANCEL, 116, 114, 70, 22
    DEFPUSHBUTTON "Open", IDOK, 194, 114, 70, 22
END
